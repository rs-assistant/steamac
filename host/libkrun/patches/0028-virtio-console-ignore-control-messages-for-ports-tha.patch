From: steamac <steamac@local>
Date: Thu, 5 Nov 2026 12:00:00 +0000
Subject: [PATCH] virtio-console: ignore control messages for ports that do not
 exist

PORT_READY indexed self.ports with the guest's cmd.id, and PORT_OPEN
queued it for port_id_to_queue_idx(), whose 2 + 2 * id then indexed
self.queues and self.ports: a guest naming a port past the configured
ones panicked the VMM.

Check the id against the number of ports before either handler uses
it, ignore the message otherwise (logged once per device), and look up
the port's queues with get() so a short queue vector cannot panic
either. DEVICE_READY only iterates the device's own ports.
---
 src/devices/src/virtio/console/device.rs | 71 ++++++++++++++++++++++--
 1 file changed, 67 insertions(+), 4 deletions(-)

diff --git a/src/devices/src/virtio/console/device.rs b/src/devices/src/virtio/console/device.rs
index 8dffca4..9ab07eb 100644
--- a/src/devices/src/virtio/console/device.rs
+++ b/src/devices/src/virtio/console/device.rs
@@ -70,6 +70,30 @@ pub struct Console {
     pub(crate) sigwinch_evt: EventFd,
 
     config: VirtioConsoleConfig,
+
+    // Set once a control message named a port that does not exist, so a
+    // misbehaving guest cannot flood the log.
+    invalid_port_id_logged: bool,
+}
+
+/// The index into `ports` of the port a guest control message names, or None
+/// when the guest named a port that does not exist (logged once per device).
+/// Checking the id before using it also bounds the queue indices derived from
+/// it (`port_id_to_queue_idx`) to the queues of existing ports.
+fn checked_port_id(id: u32, num_ports: usize, event: &str, logged: &mut bool) -> Option<usize> {
+    match usize::try_from(id) {
+        Ok(port_id) if port_id < num_ports => Some(port_id),
+        _ => {
+            if !*logged {
+                *logged = true;
+                log::warn!(
+                    "Ignoring console {event} for invalid port {id} ({num_ports} ports); \
+                     further invalid port ids are ignored silently"
+                );
+            }
+            None
+        }
+    }
 }
 
 impl Console {
@@ -105,6 +129,7 @@ impl Console {
                 .map_err(super::ConsoleError::EventFd)?,
             device_state: DeviceState::Inactive,
             config,
+            invalid_port_id_logged: false,
         })
     }
 
@@ -208,8 +233,16 @@ impl Console {
                         log::error!("Port initialization failed: {cmd:?}");
                         continue;
                     }
+                    let Some(port_id) = checked_port_id(
+                        cmd.id,
+                        self.ports.len(),
+                        "PORT_READY",
+                        &mut self.invalid_port_id_logged,
+                    ) else {
+                        continue;
+                    };
 
-                    if let Some(term) = self.ports[cmd.id as usize].terminal() {
+                    if let Some(term) = self.ports[port_id].terminal() {
                         self.control.mark_console_port(mem, cmd.id);
                         self.control.port_open(cmd.id, true);
                         let (cols, rows) = term.get_win_size();
@@ -221,7 +254,7 @@ impl Console {
                         self.control.port_open(cmd.id, true)
                     }
 
-                    let name = self.ports[cmd.id as usize].name();
+                    let name = self.ports[port_id].name();
                     log::trace!("Port ready {id}: {name}", id = cmd.id);
                     if !name.is_empty() {
                         self.control.port_name(cmd.id, name)
@@ -246,7 +279,15 @@ impl Console {
                         continue;
                     }
 
-                    ports_to_start.push(cmd.id as usize);
+                    let Some(port_id) = checked_port_id(
+                        cmd.id,
+                        self.ports.len(),
+                        "PORT_OPEN",
+                        &mut self.invalid_port_id_logged,
+                    ) else {
+                        continue;
+                    };
+                    ports_to_start.push(port_id);
                 }
                 _ => log::warn!("Unknown console control event {:x}", cmd.event),
             }
@@ -260,7 +301,10 @@ impl Console {
             // The guest sends PORT_OPEN again on every close/reopen of the port
             // (one opener at a time in Linux virtio_console). The port's I/O
             // already owns its queues and keeps running across reopens.
-            if self.queues[rx_idx].is_none() || self.queues[tx_idx].is_none() {
+            // port_id is a valid port (checked_port_id), but use get() so that
+            // a transport that activated fewer queues cannot panic us either.
+            let has_queue = |idx: usize| matches!(self.queues.get(idx), Some(Some(_)));
+            if !has_queue(rx_idx) || !has_queue(tx_idx) {
                 log::debug!(
                     "console port {port_id} reopened by the guest; port io already running"
                 );
@@ -377,3 +421,22 @@ impl VmmExitObserver for Console {
         log::trace!("Console on_vmm_exit finished");
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::checked_port_id;
+
+    #[test]
+    fn test_checked_port_id() {
+        let mut logged = false;
+        assert_eq!(checked_port_id(0, 2, "PORT_OPEN", &mut logged), Some(0));
+        assert_eq!(checked_port_id(1, 2, "PORT_OPEN", &mut logged), Some(1));
+        assert!(!logged);
+        assert_eq!(checked_port_id(2, 2, "PORT_OPEN", &mut logged), None);
+        assert!(logged);
+        assert_eq!(
+            checked_port_id(u32::MAX, 2, "PORT_READY", &mut logged),
+            None
+        );
+    }
+}
