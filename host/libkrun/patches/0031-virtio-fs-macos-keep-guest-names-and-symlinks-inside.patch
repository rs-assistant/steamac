+                unsafe { bindings::statvfs64(c_path.as_ptr(), out.as_mut_ptr()) }
+            }
             InodeHandle::Fd(fd) => unsafe { bindings::fstatvfs64(fd, out.as_mut_ptr()) },
         };
         if res == 0 {
@@ -2139,7 +2188,17 @@ impl FileSystem for PassthroughFs {
         let link_c_path = self.name_to_path(newparent, newname)?;
 
         // Safe because this doesn't modify any memory and we check the return value.
-        let res = unsafe { libc::link(orig_c_path.as_ptr(), link_c_path.as_ptr()) };
+        // linkat without AT_SYMLINK_FOLLOW links the inode itself; link(2) on macOS follows a
