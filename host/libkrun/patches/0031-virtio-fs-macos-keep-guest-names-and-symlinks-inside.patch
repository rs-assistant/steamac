@@ -722,6 +743,7 @@ impl PassthroughFs {
             parent,
             name.to_string_lossy()
         );
+        check_name(name)?;
         let data = self
             .inodes
             .read()
@@ -763,10 +785,12 @@ impl PassthroughFs {
 
         let ihandle = self.inode_to_handle(inode, true)?;
         let fd = match ihandle {
+            // O_NOFOLLOW: if the inode is a symlink, opening its path would open the link's
