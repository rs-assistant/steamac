     if ret < 0 {
@@ -1250,7 +1289,11 @@ fn set_secctx(file: &InodeHandle, secctx: SecContext, symlink: bool) -> io::Resu
 fn remove_security_capability(file: &InodeHandle) {
     let ret = match file {
