+            // target of a symlink.
             InodeHandle::Path(c_path) => unsafe {
                 libc::setxattr(
                     c_path.as_ptr(),
@@ -2373,7 +2434,7 @@ impl FileSystem for PassthroughFs {
                     value.as_ptr() as *const libc::c_void,
