+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::os::unix::fs::{symlink, MetadataExt, PermissionsExt};
+    use std::path::PathBuf;
+
+    fn linux_errno(errno: i32) -> Option<i32> {
+        linux_error(io::Error::from_raw_os_error(errno)).raw_os_error()
+    }
+
+    fn ctx() -> Context {
+        Context {
+            uid: 0,
+            gid: 0,
+            pid: 0,
+        }
+    }
+
+    fn c(s: &str) -> CString {
+        CString::new(s).unwrap()
+    }
+
+    // <tmp>/<unique>/{outside/secret, share/{esc -> outside/secret, escdir -> outside}}
+    struct Fixture {
+        base: PathBuf,
+        fs: PassthroughFs,
+    }
+
+    impl Fixture {
+        fn new(tag: &str) -> Self {
+            let base = std::env::temp_dir()
+                .canonicalize()
+                .unwrap()
+                .join(format!("krun-fs-confine-{}-{tag}", std::process::id()));
+            let _ = fs::remove_dir_all(&base);
+            fs::create_dir_all(base.join("outside")).unwrap();
+            fs::create_dir_all(base.join("share")).unwrap();
+            fs::write(base.join("outside/secret"), b"host").unwrap();
+            fs::set_permissions(
+                base.join("outside/secret"),
+                fs::Permissions::from_mode(0o600),
+            )
+            .unwrap();
+            symlink(base.join("outside/secret"), base.join("share/esc")).unwrap();
+            symlink(base.join("outside"), base.join("share/escdir")).unwrap();
+
+            let cfg = Config {
+                root_dir: base.join("share").to_str().unwrap().to_string(),
+                semantics: PermissionSemantics::LinuxSimplified,
+                ..Default::default()
+            };
+            let fs = PassthroughFs::new(cfg, Arc::new(InodeAllocator::new())).unwrap();
+            fs.init(FsOptions::empty()).unwrap();
+            Fixture { base, fs }
+        }
+
+        fn secret(&self) -> fs::Metadata {
+            fs::metadata(self.base.join("outside/secret")).unwrap()
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.base);
+        }
+    }
+
+    #[test]
+    fn check_name_accepts_one_entry_only() {
+        for ok in ["a", "...", ".a", "a.", "a b", "\u{e9}"] {
+            assert!(check_name(&c(ok)).is_ok(), "{ok:?}");
+        }
+        for bad in ["", ".", "..", "/", "a/b", "../a", "a/..", "/etc"] {
+            let err = check_name(&c(bad)).err().unwrap();
+            assert_eq!(err.raw_os_error(), linux_errno(libc::EINVAL), "{bad:?}");
+        }
+    }
+
+    #[test]
+    fn names_cannot_leave_the_shared_directory() {
+        let f = Fixture::new("names");
+        let root = fuse::ROOT_ID;
+        let einval = linux_errno(libc::EINVAL);
+
+        for name in ["..", ".", "../outside", "escdir/secret", ""] {
+            let err = f.fs.lookup(ctx(), root, &c(name)).err().unwrap();
+            assert_eq!(err.raw_os_error(), einval, "lookup {name:?}");
+        }
+
+        let err =
+            f.fs.mkdir(ctx(), root, &c("../made"), 0o755, 0, Extensions::default())
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(!f.base.join("made").exists());
+
+        let err =
+            f.fs.create(
+                ctx(),
+                root,
+                &c("../outside/new"),
+                0o644,
+                false,
+                0,
+                0,
+                Extensions::default(),
+            )
+            .err()
+            .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(!f.base.join("outside/new").exists());
+
+        let err =
+            f.fs.mknod(
+                ctx(),
+                root,
+                &c("../outside/node"),
+                libc::S_IFIFO as u32 | 0o644,
+                0,
+                0,
+                Extensions::default(),
+            )
+            .err()
+            .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(!f.base.join("outside/node").exists());
+
+        let err =
+            f.fs.symlink(ctx(), &c("x"), root, &c("../link"), Extensions::default())
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(fs::symlink_metadata(f.base.join("link")).is_err());
+
+        let err =
+            f.fs.unlink(ctx(), root, &c("../outside/secret"))
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        let err = f.fs.rmdir(ctx(), root, &c("../outside")).err().unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(f.base.join("outside/secret").exists());
+
+        fs::write(f.base.join("share/inside"), b"guest").unwrap();
+        let err =
+            f.fs.rename(ctx(), root, &c("inside"), root, &c("../moved"), 0)
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        let err =
+            f.fs.rename(ctx(), root, &c("../outside/secret"), root, &c("taken"), 0)
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(f.base.join("share/inside").exists());
+        assert!(f.base.join("outside/secret").exists());
+
+        let inside = f.fs.lookup(ctx(), root, &c("inside")).unwrap();
+        let err =
+            f.fs.link(ctx(), inside.inode, root, &c("../outside/linked"))
+                .err()
+                .unwrap();
+        assert_eq!(err.raw_os_error(), einval);
+        assert!(!f.base.join("outside/linked").exists());
+    }
+
+    #[test]
+    fn symlinks_in_the_share_are_not_followed() {
+        let f = Fixture::new("symlinks");
+        let root = fuse::ROOT_ID;
+        let eloop = linux_errno(libc::ELOOP);
+
+        // lookup reports the link itself.
+        let esc = f.fs.lookup(ctx(), root, &c("esc")).unwrap();
+        assert_eq!(esc.attr.st_mode & libc::S_IFMT, libc::S_IFLNK);
+        let escdir = f.fs.lookup(ctx(), root, &c("escdir")).unwrap();
+        assert_eq!(escdir.attr.st_mode & libc::S_IFMT, libc::S_IFLNK);
+
+        // open/opendir of a link inode does not reach the target.
+        let err = f.fs.open(ctx(), esc.inode, false, 0).err().unwrap();
+        assert_eq!(err.raw_os_error(), eloop);
+        let err = f.fs.opendir(ctx(), escdir.inode, 0).err().unwrap();
+        assert_eq!(err.raw_os_error(), eloop);
+
+        // Truncating through the link inode (no handle) leaves the target alone.
+        let mut attr: bindings::stat64 = unsafe { std::mem::zeroed() };
+        attr.st_size = 0;
+        assert!(f
+            .fs
+            .setattr(ctx(), esc.inode, attr, None, SetattrValid::SIZE)
+            .is_err());
+        assert_eq!(fs::read(f.base.join("outside/secret")).unwrap(), b"host");
+
+        // chmod through the link inode leaves the target's mode alone.
+        attr.st_mode = 0o777;
+        let _ =
+            f.fs.setattr(ctx(), esc.inode, attr, None, SetattrValid::MODE);
+        assert_eq!(f.secret().permissions().mode() & 0o7777, 0o600);
+
+        // A hard link of the link inode links the symlink, not its target.
+        let before = f.secret().nlink();
+        if f.fs.link(ctx(), esc.inode, root, &c("hard")).is_ok() {
+            let md = fs::symlink_metadata(f.base.join("share/hard")).unwrap();
+            assert!(md.file_type().is_symlink());
+        }
+        assert_eq!(f.secret().nlink(), before);
+
+        // statfs does not report the target's filesystem.
+        assert!(f.fs.statfs(ctx(), esc.inode).is_err());
+    }
+}
